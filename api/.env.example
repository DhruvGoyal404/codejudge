# Copy to api/.env and fill in. api/.env is gitignored; never commit real values.
# GitHub OAuth App (scope read:user). The callback registered on the app must
# equal GITHUB_REDIRECT_URI exactly (dev: localhost, not 127.0.0.1).
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback
