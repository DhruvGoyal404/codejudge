# /etc/codejudge/prod.env (root:codejudge 0640). On AWS deploy.sh renders it from
# SSM Parameter Store (/codejudge/prod/*) and the release manifest; this example
# is for other hosts. Never commit a filled-in copy.
# Used by: docker compose -f deploy/compose.prod.yaml --env-file /etc/codejudge/prod.env ...
CODEJUDGE_DOMAIN=judge.dhruvgoyal.tech
PUBLIC_ORIGIN=https://judge.dhruvgoyal.tech
ACME_EMAIL=you@example.com
# Long random values, e.g.: openssl rand -base64 36 | tr -d '/+='
CODEJUDGE_PG_PASSWORD=change-me
CODEJUDGE_VALKEY_PASSWORD=change-me
# GitHub OAuth App whose callback is exactly GITHUB_REDIRECT_URI
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=https://judge.dhruvgoyal.tech/api/auth/github/callback
# Images pinned by digest (written by deploy.sh from the release manifest).
CODEJUDGE_API_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/codejudge/api@sha256:...
CODEJUDGE_WEB_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/codejudge/web@sha256:...
