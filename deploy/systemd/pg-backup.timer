# /etc/systemd/system/pg-backup.timer — nightly at 03:30 UTC (Persistent:
# a run missed while the host was down happens at the next boot).
[Unit]
Description=Nightly CodeJudge Postgres backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
