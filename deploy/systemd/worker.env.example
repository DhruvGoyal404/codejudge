# /etc/codejudge/worker.env (root:codejudge 0640). Copy, fill in, never commit.
# Postgres and Valkey are reached through Unix sockets (no published ports).
CODEJUDGE_DATABASE_URL=postgres://codejudge:change-me@/codejudge?host=/run/codejudge/postgresql&sslmode=disable
CODEJUDGE_VALKEY_URL=unix://:change-me@/run/codejudge/valkey/valkey.sock
CODEJUDGE_PROBLEMS_DIR=/opt/codejudge/current/app/problems
# Hidden tests: a checkout of the private codejudge-problems repo (read-only deploy key).
CODEJUDGE_PROBLEMS_TESTS_DIR=/opt/codejudge/problems-private
